self.arch
<form string="Product Variant">
                    <header>
                        <button string="Variant Prices" type="action" name="116" invisible="1" modifiers="{&quot;invisible&quot;: true}" readonly="0"/>
                    <button name="release" states="confirmed" string="Release Component" type="workflow" icon="gtk-apply" class="oe_highlight" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;not in&quot;, [&quot;confirmed&quot;]]]}" readonly="0"/>
                <button name="correct" states="confirmed" string="Correct Component" type="workflow" icon="gtk-cancel" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;not in&quot;, [&quot;confirmed&quot;]]]}" readonly="0"/>
                <button name="confirm" states="draft" string="Confirm Component" type="workflow" icon="gtk-go-forward" class="oe_highlight" modifiers="{&quot;invisible&quot;: [[&quot;state&quot;, &quot;not in&quot;, [&quot;draft&quot;]]]}" readonly="0"/>
                <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,released" statusbar_colors="{&quot;undermodify&quot;:&quot;red&quot;,&quot;obsoleted&quot;:&quot;red&quot;}" modifiers="{&quot;readonly&quot;: true}"/>
                <button string="Update Qty On Hand" type="action" name="234" attrs="{'invisible': [('type', '!=', 'product')]}" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;product&quot;]]}" readonly="0"/>
                        <button string="Procurement Request" type="action" name="236" attrs="{'invisible': [('type', '!=', 'product')]}" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;product&quot;]]}" readonly="0"/>
                    </header>
                    <sheet>
                <div name="button_box" class="oe_button_box"> 
                    <button class="oe_stat_button" name="product_template_open" type="object" string="Product Infos" icon="fa-gears">  
                    </button> 
                <button class="oe_stat_button" name="action_view_bom" type="object" attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}" icon="fa-flask" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;not in&quot;, [&quot;product&quot;, &quot;consu&quot;]]]}">
                        <field string="Bill of Materials" name="bom_count" widget="statinfo" modifiers="{&quot;readonly&quot;: true}"/>
                    </button>
                    <button class="oe_stat_button" name="303" type="action" attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}" icon="fa-list-alt" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;not in&quot;, [&quot;product&quot;, &quot;consu&quot;]]]}" readonly="0">
                        <field string="Manufacturing" name="mo_count" widget="statinfo" modifiers="{&quot;readonly&quot;: true}"/>
                    </button>
                <button class="oe_stat_button" name="278" icon="fa-building-o" type="action" attrs="{'invisible':[('type', '!=', 'product')]}" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;product&quot;]]}" readonly="0">
                            <field name="qty_available" widget="statinfo" string="On Hand" modifiers="{&quot;readonly&quot;: true}"/>
                        </button>
                        <button type="action" name="239" attrs="{'invisible':[('type', '!=', 'product')]}" class="oe_stat_button" icon="fa-building-o" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;!=&quot;, &quot;product&quot;]]}" readonly="0">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="virtual_available" widget="statinfo" nolabel="1" modifiers="{&quot;readonly&quot;: true}"/>
                                    <span attrs="{'invisible':[('outgoing_qty', '=', 0),('incoming_qty','=',0)]}" modifiers="{&quot;invisible&quot;: [[&quot;outgoing_qty&quot;, &quot;=&quot;, 0], [&quot;incoming_qty&quot;, &quot;=&quot;, 0]]}">
                                        (-<field name="outgoing_qty" widget="statinfo" nolabel="1" modifiers="{&quot;readonly&quot;: true}"/>
                                        +<field name="incoming_qty" widget="statinfo" nolabel="1" modifiers="{&quot;readonly&quot;: true}"/>)
                                    </span>
                                </span>
                                <span class="o_stat_text">Forecasted</span>
                            </div>
                        </button>
                       <button string="Traceability" type="action" name="264" attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}" class="oe_stat_button" icon="fa-arrows-v" modifiers="{&quot;invisible&quot;: [[&quot;type&quot;, &quot;not in&quot;, [&quot;product&quot;, &quot;consu&quot;]]]}" readonly="0"/>
                       <button type="action" name="276" attrs="{'invisible':['|',('type', '!=', 'product'),('nbr_reordering_rules', '==', 1)]}" class="oe_stat_button" icon="fa-refresh" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;type&quot;, &quot;!=&quot;, &quot;product&quot;], [&quot;nbr_reordering_rules&quot;, &quot;==&quot;, 1]]}" readonly="0">
                            <field name="nbr_reordering_rules" widget="statinfo" modifiers="{&quot;readonly&quot;: true}"/>
                        </button>
                        <button name="276" type="action" attrs="{'invisible':['|',('type', '!=', ['product', 'consu']),('nbr_reordering_rules', '!=', 1)]}" class="oe_stat_button" icon="fa-refresh" modifiers="{&quot;invisible&quot;: [&quot;|&quot;, [&quot;type&quot;, &quot;!=&quot;, [&quot;product&quot;, &quot;consu&quot;]], [&quot;nbr_reordering_rules&quot;, &quot;!=&quot;, 1]]}" readonly="0">
                            <div class="o_form_field o_stat_info mr4">
                                <span class="o_stat_text">Min :</span>
                                <span class="o_stat_text">Max:</span>
                            </div>
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value"><field name="reordering_min_qty" modifiers="{&quot;readonly&quot;: true}"/></span>
                                <span class="o_stat_value"><field name="reordering_max_qty" modifiers="{&quot;readonly&quot;: true}"/></span>
                            </div>
                        </button>
                       <button string="Routes" type="object" name="action_view_routes" class="oe_stat_button" icon="fa-cogs" invisible="1" modifiers="{&quot;invisible&quot;: true}"/>
                    <button class="oe_stat_button" name="224" icon="fa-truck" string="Procurements" type="action" invisible="1" modifiers="{&quot;invisible&quot;: true}" readonly="0"/>
                </div>  
           <field name="type" invisible="1" on_change="1" modifiers="{&quot;invisible&quot;: true, &quot;required&quot;: true}"/>
                 <group colspan="6" col="2">
                      <field name="name" on_change="1" invisible="1" modifiers="{&quot;invisible&quot;: true, &quot;required&quot;: true}"/>
                 </group>
           <group colspan="6" col="6" name="PNArea">
             <group colspan="6" col="6">
              <field name="engineering_code" colspan="4" attrs="{'readonly':[('state','!=','draft')]}" select="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;!=&quot;, &quot;draft&quot;]]}"/>
               <field name="engineering_revision" colspan="2" readonly="True" modifiers="{&quot;readonly&quot;: true, &quot;required&quot;: true}"/>
               <field name="std_description" colspan="4" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" on_change="on_change_stddesc(std_description)" can_create="false" can_write="false" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/> 
               <field name="state" colspan="2" readonly="True" modifiers="{&quot;readonly&quot;: true}"/>
               <label for="description" colspan="6"/>
               <field name="description" colspan="6" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" nolabel="1" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
           </group>
           </group>

    <notebook colspan="6" col="6">
    <page name="techincal_infos" string="Technical Infos">
            <group colspan="4" col="4" name="TechnicalInfos">
           <field name="tmp_material" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" on_change="on_change_tmpmater(tmp_material)" can_create="false" can_write="false" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
         <field name="tmp_surface" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" on_change="on_change_tmpsurface(tmp_surface)" can_create="false" can_write="false" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
             <field name="weight" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" digits="(14, 3)" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
             <field name="uom_id" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" on_change="onchange_uom(uom_id,uom_po_id)" can_create="false" can_write="false" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]], &quot;required&quot;: true}"/>
                            <field name="uom_po_id" can_create="false" can_write="false" invisible="1" modifiers="{&quot;invisible&quot;: true, &quot;required&quot;: true}"/>
         </group>
    <group col="4" colspan="4">
        <field name="std_umc1" attrs="{'readonly':[('std_umc1','=',False),('state','in',['released','obsoleted'])]}" modifiers="{&quot;readonly&quot;: [[&quot;std_umc1&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
        <field name="std_value1" attrs="{'readonly':[('std_umc1','=',False),('state','in',['released','obsoleted'])]}" on_change="on_change_stdvalue(std_description, std_umc1, std_value1, std_umc2, std_value2, std_umc3, std_value3)" modifiers="{&quot;readonly&quot;: [[&quot;std_umc1&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
        <field name="std_umc2" attrs="{'readonly':[('std_umc2','=',False),('state','in',['released','obsoleted'])]}" modifiers="{&quot;readonly&quot;: [[&quot;std_umc2&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
        <field name="std_value2" attrs="{'readonly':[('std_umc2','=',False),('state','in',['released','obsoleted'])]}" on_change="on_change_stdvalue(std_description, std_umc1, std_value1, std_umc2, std_value2, std_umc3, std_value3)" modifiers="{&quot;readonly&quot;: [[&quot;std_umc2&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
        <field name="std_umc3" attrs="{'readonly':[('std_umc3','=',False),('state','in',['released','obsoleted'])]}" modifiers="{&quot;readonly&quot;: [[&quot;std_umc3&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
        <field name="std_value3" attrs="{'readonly':[('std_umc3','=',False),('state','in',['released','obsoleted'])]}" on_change="on_change_stdvalue(std_description, std_umc1, std_value1, std_umc2, std_value2, std_umc3, std_value3)" modifiers="{&quot;readonly&quot;: [[&quot;std_umc3&quot;, &quot;=&quot;, false], [&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
    </group>
    </page>
    <page name="titleblock_info" string="TitleBlock Informations"> 
    <group name="TBlock">
               <field name="engineering_material" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" colspan="2" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/>
        <field name="engineering_surface" attrs="{'readonly':[('state','in',['released','obsoleted'])]}" colspan="2" modifiers="{&quot;readonly&quot;: [[&quot;state&quot;, &quot;in&quot;, [&quot;released&quot;, &quot;obsoleted&quot;]]]}"/> 
        </group>
    </page>
    <page name="linked_document" string="Linked Documents"> 
    <group>
    <button class="oe_inline oe_stat_button" type="object" icon="fa-list-alt" name="action_rev_docs" string="Revision Rel Docs"/>
               </group>
               <group>
    <field name="linkeddocuments" nolabel="1" can_create="true" can_write="true" modifiers="{}"/>
        </group>
    </page>
    </notebook> 
    </sheet>
